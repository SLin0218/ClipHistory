<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 com rescap">

  <Identity
    Name="SlinClip.CommandPalette"
    Publisher="CN=SlinClip"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Slin-Clip 剪切板扩展</DisplayName>
    <PublisherDisplayName>SlinClip</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Applications>
    <Application Id="App" Executable="SlinClipCmdPal.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Slin-Clip 剪切板扩展"
        Description="PowerToys Run V2 剪切板历史管理扩展"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Out-of-Process COM Server -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="SlinClipCmdPal.exe" Arguments="-RegisterProcessAsComServer" DisplayName="Slin-Clip Extension Server">
              <com:Class Id="CA55B77B-582E-47C0-8B41-C68427BFB331" DisplayName="ClipExtension" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <!-- Command Palette App Extension -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension
            Name="com.microsoft.commandpalette"
            Id="SlinClipCmdPalExtension"
            PublicFolder="Public"
            DisplayName="Slin-Clip 剪切板历史"
            Description="极速图文剪切板管理与智能搜索">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation>
                  <CreateInstance ClassId="CA55B77B-582E-47C0-8B41-C68427BFB331" />
                </Activation>
                <SupportedInterfaces>
                  <Commands />
                </SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
