<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClipHistoryCmdPal</AssemblyName>
    <RootNamespace>ClipHistoryCmdPal</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <CsWinRTIncludes>Microsoft.CommandPalette.Extensions</CsWinRTIncludes>
    <CsWinRTWindowsMetadata>$(UserProfile)\.nuget\packages\microsoft.windows.sdk.net.ref\10.0.22000.56\winmd</CsWinRTWindowsMetadata>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.1.1" />
    <PackageReference Include="Shmuelie.WinRTServer" Version="2.2.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <CsWinRTInputs Include="C:\Program Files\WindowsApps\Microsoft.CommandPalette_0.11.11762.0_x64__8wekyb3d8bbwe\Microsoft.CommandPalette.Extensions.winmd" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Models\*.cs" Link="Models\%(Filename)%(Extension)" />
    <Compile Include="..\Services\*.cs" Link="Services\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
