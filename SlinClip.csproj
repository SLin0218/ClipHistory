<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <LangVersion>12</LangVersion>
    <AssemblyName>SlinClip</AssemblyName>
    <RootNamespace>SlinClip</RootNamespace>
    <Platforms>x64;AnyCPU</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <NoWarn>$(NoWarn);CS1705</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1705</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ref\**" />
  </ItemGroup>

  <!-- 引用编译契约 Wox.Plugin 核心库（发布时不输出，运行时由宿主提供） -->
  <ItemGroup>
    <Reference Include="Wox.Plugin">
      <HintPath>ref\Wox.Plugin\bin\Release\net8.0-windows\Wox.Plugin.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 将插件配置文件与图标复制到输出目录 -->
  <ItemGroup>
    <None Update="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Images\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
